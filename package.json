{
  "name": "astudio-wysiwyg-editor",
  "version": "1.3.1",
  "description": "Astudio WYSIWYG Rich HTML Editor — free zero-dependency base version",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Astudio LLC",
  "homepage": "https://astudio.am/en",
  "repository": {
    "type": "git",
    "url": "https://github.com/AstudioLLC/astudio-wysiwyg-html-editor.git"
  },
  "scripts": {
    "test": "node --check src/custom-editor.js && node --check src/custom-editor.esm.js"
  },
  "main": "dist/custom-editor.js",
  "module": "dist/custom-editor.esm.js",
  "browser": "dist/custom-editor.js",
  "unpkg": "dist/custom-editor.js",
  "style": "dist/custom-editor.css",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./dist/custom-editor.esm.js",
      "require": "./dist/custom-editor.js",
      "default": "./dist/custom-editor.js"
    },
    "./custom-editor.css": "./dist/custom-editor.css",
    "./custom-editor-embed.css": "./dist/custom-editor-embed.css",
    "./custom-editor.js": "./dist/custom-editor.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/custom-editor.js",
    "dist/custom-editor.esm.js",
    "dist/custom-editor.css",
    "dist/custom-editor-embed.css",
    "src/custom-editor.js",
    "src/custom-editor.esm.js",
    "src/custom-editor.css",
    "src/custom-editor-embed.css",
    "examples/basic/demo.html",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "VERSION"
  ],
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "ckeditor",
    "contenteditable",
    "astudio"
  ],
  "sideEffects": [
    "./dist/custom-editor.js",
    "./dist/custom-editor.css",
    "./dist/custom-editor-embed.css"
  ]
}
